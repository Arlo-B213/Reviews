rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read and submit reviews; edits and deletes are done by the owner in the console.
    match /reviews/{id} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['business','reviewer','stars','date','review','photos','createdAt'])
        && request.resource.data.business is string
        && request.resource.data.reviewer is string && request.resource.data.reviewer.size() <= 80
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.review is string && request.resource.data.review.size() <= 5000
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 3
        && request.resource.data.createdAt == request.time;
    }
  }
}
